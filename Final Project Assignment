    {
      "cell_type": "code",
      "source": [
        "from dateutil import parser as dateparser\n",
        "import json, gc, torch, re\n",
        "from pathlib import Path\n",
        "from PIL import Image\n",
        "\n",
        "def norm_money(s):\n",
        "    if not s: return None\n",
        "    s = re.sub(r\"[^0-9.]\", \"\", str(s))\n",
        "    try: return round(float(s), 2)\n",
        "    except: return None\n",
        "\n",
        "def norm_date(s):\n",
        "    if not s: return None\n",
        "    try: return dateparser.parse(s, dayfirst=False, yearfirst=False).date()\n",
        "    except: return None\n",
        "\n",
        "# prerequisites\n",
        "try:\n",
        "    CFG; ds; extract_entities\n",
        "except NameError as e:\n",
        "    raise RuntimeError(\"Missing prerequisites. Run Cells 4 (Config) and 6 (Dataset) first.\") from e\n",
        "\n",
        "try:\n",
        "    DEVICE\n",
        "except NameError:\n",
        "    DEVICE = torch.device(\"cuda\" if torch.cuda.is_available() else \"cpu\")\n",
        "\n",
        "# load model/processor\n",
        "try:\n",
        "    processor; model\n",
        "except NameError:\n",
        "    from transformers import DonutProcessor, VisionEncoderDecoderModel\n",
        "    ckpt_dir = Path(CFG.OUTPUT_DIR)\n",
        "    if not ckpt_dir.exists():\n",
        "        raise RuntimeError(\"No checkpoint found. Train (Cell 12) first.\")\n",
        "    processor = DonutProcessor.from_pretrained(CFG.OUTPUT_DIR)\n",
        "    model = VisionEncoderDecoderModel.from_pretrained(CFG.OUTPUT_DIR).to(DEVICE)\n",
        "model.eval()\n",
