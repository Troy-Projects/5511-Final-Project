    {
      "cell_type": "code",
      "source": [
        "import re\n",
        "try:\n",
        "    import pytesseract\n",
        "    pytesseract_available = True\n",
        "except Exception:\n",
        "    pytesseract_available = False\n",
        "\n",
        "money_re = re.compile(r\"(?<!\\d)(\\d{1,3}(?:,\\d{3})*(?:\\.\\d{2})?)\")\n",
        "date_re  = re.compile(r\"(\\d{1,2}[\\/\\- ]\\d{1,2}[\\/\\- ]\\d{2,4})\")\n",
        "\n",
        "def baseline_predict_text(img):\n",
        "    if not pytesseract_available:\n",
        "        return {\"company\": None, \"date\": None, \"address\": None, \"total\": None}\n",
        "    text = pytesseract.image_to_string(img)\n",
        "    tot = max(money_re.findall(text), key=lambda s: len(s), default=None)\n",
        "    d   = date_re.search(text)\n",
        "    return {\"company\": None, \"date\": d.group(1) if d else None, \"address\": None, \"total\": tot}\n",
        "\n",
        "print(\"Tesseract available:\", pytesseract_available)\n"
      ],
