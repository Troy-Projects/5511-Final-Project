    {
      "cell_type": "code",
      "source": [
        "import json, csv, gc, torch\n",
        "from pathlib import Path\n",
        "from PIL import Image\n",
        "\n",
        "print(\"Device:\", DEVICE, \"| CUDA:\", torch.cuda.is_available())\n",
        "\n",
        "# Ensure prerequisites\n",
        "try:\n",
        "    CFG\n",
        "    ds\n",
        "except NameError as e:\n",
        "    raise RuntimeError(\"Missing prerequisites. Run Cells 4 (Config) and 6 (Dataset) first.\") from e\n",
        "\n",
        "# Load processor/model from checkpoint\n",
        "try:\n",
        "    processor\n",
        "    model\n",
        "except NameError:\n",
        "    from transformers import DonutProcessor, VisionEncoderDecoderModel\n",
        "    ckpt_dir = Path(CFG.OUTPUT_DIR)\n",
        "    if not ckpt_dir.exists():\n",
        "        raise RuntimeError(\"No checkpoint found in OUTPUT_DIR. Train (Cell 12) first, then re-run this cell.\")\n",
        "    processor = DonutProcessor.from_pretrained(CFG.OUTPUT_DIR)\n",
        "    model = VisionEncoderDecoderModel.from_pretrained(CFG.OUTPUT_DIR).to(DEVICE)\n",
        "\n",
        "model.eval()\n",
        "\n",
        "\n",
        "base_split = ds[\"test\"] if \"test\" in ds and len(ds[\"test\"]) > 0 else ds[\"validation\"]\n",
        "CAP = min(8, len(base_split))\n",
        "\n",
        "# Prompt & target schema\n",
        "TARGET_TEMPLATE = {\"company\":\"\", \"date\":\"\", \"address\":\"\", \"total\":\"\"}\n",
        "prompt_json = json.dumps({\"gt_parse\": TARGET_TEMPLATE}, ensure_ascii=False)\n",
        "prompt_ids = processor.tokenizer(prompt_json, add_special_tokens=False, return_tensors=\"pt\").input_ids.to(DEVICE)\n",
        "\n",
        "# Output CSV path\n",
        "out_dir = Path(CFG.OUTPUT_DIR); out_dir.mkdir(parents=True, exist_ok=True)\n",
        "out_csv = out_dir / \"sroie_predictions.csv\"\n",
        "\n",
        "# Downscale inputs to reduce RAM/VRAM\n",
        "# DonutImageProcessor accepts a size override; smaller = cheaper.\n",
        "RESIZE = {\"height\": 768, \"width\": 512}\n",
        "\n",
        "# Generation limits for speed/memory\n",
        "MAX_NEW_TOKENS = 64\n",
        "\n",
        "# Stream inference to CSV\n",
