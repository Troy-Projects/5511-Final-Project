        "## Deep Model: Donut\n",
        "\n",
        "Model  \n",
        "Donut is a vision encoder/decoder that predicts a JSON object from the image itself, avoiding external OCR failure modes.\n",
        "\n",
        "Training  \n",
        "Fine-tune Donut in order to emit the four target fields. Monitor validation loss each epoch; and keep the best checkpoint.\n"
      ],
      "metadata": {
        "id": "vuxacDqZmzN8"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import DonutProcessor, VisionEncoderDecoderModel\n",
        "import json, torch\n",
        "from torch.utils.data import Dataset, DataLoader\n",
        "from pathlib import Path\n",
        "from PIL import Image\n",
        "\n",
        "processor = DonutProcessor.from_pretrained(CFG.FINETUNE_FROM or CFG.MODEL_NAME)\n",
        "model = VisionEncoderDecoderModel.from_pretrained(CFG.FINETUNE_FROM or CFG.MODEL_NAME).to(DEVICE)\n",
        "\n",
        "TARGET_TEMPLATE = {\"company\":\"\", \"date\":\"\", \"address\":\"\", \"total\":\"\"}\n",
        "\n",
        "def make_target_str(example):\n",
        "    ents = extract_entities(example)\n",
        "    tgt = {k: (ents.get(k) or \"\") for k in TARGET_TEMPLATE}\n",
        "    return json.dumps({\"gt_parse\": tgt}, ensure_ascii=False)\n",
        "\n",
        "# Caps for quick passes\n",
        "train_cap = CFG.MAX_TRAIN_SAMPLES or len(ds[\"train\"])\n",
        "val_cap   = CFG.MAX_EVAL_SAMPLES  or len(ds[\"validation\"])\n",
        "train_split = ds[\"train\"].select(range(min(len(ds[\"train\"]), train_cap)))\n",
        "val_split   = ds[\"validation\"].select(range(min(len(ds[\"validation\"]), val_cap)))\n",
        "\n",
        "class DonutMapDataset(Dataset):\n",
        "    def __init__(self, hf_split): self.data = hf_split\n",
        "    def __len__(self): return len(self.data)\n",
        "    def __getitem__(self, idx):\n",
        "        ex = self.data[idx]\n",
        "        img = ex[\"image\"] if isinstance(ex[\"image\"], Image.Image) else ex[\"image\"]\n",
        "        px  = processor(img, return_tensors=\"pt\").pixel_values.squeeze(0)\n",
        "        dec = processor.tokenizer(make_target_str(ex), add_special_tokens=False, return_tensors=\"pt\").input_ids.squeeze(0)\n",
        "        return px, dec\n",
        "\n",
        "def collate(batch):\n",
        "    px = torch.stack([b[0] for b in batch])\n",
        "    max_len = max(b[1].shape[0] for b in batch)\n",
        "    pad_id = processor.tokenizer.pad_token_id\n",
        "    dec = torch.full((len(batch), max_len), pad_id, dtype=torch.long)\n",
        "    for i, (_, ids) in enumerate(batch): dec[i, :ids.shape[0]] = ids\n",
        "    return {\"pixel_values\": px, \"labels\": dec}\n",
        "\n",
        "train_loader = DataLoader(DonutMapDataset(train_split), batch_size=CFG.BATCH, shuffle=True, num_workers=CFG.NUM_WORKERS, collate_fn=collate)\n",
        "val_loader   = DataLoader(DonutMapDataset(val_split),   batch_size=CFG.BATCH, shuffle=False, num_workers=CFG.NUM_WORKERS, collate_fn=collate)\n",
        "\n",
        "optimizer = torch.optim.AdamW(model.parameters(), lr=CFG.LR)\n",
        "\n",
        "@torch.no_grad()\n",
        "def eval_loss():\n",
        "    model.eval(); losses=[]\n",
        "    for batch in val_loader:\n",
        "        batch = {k:v.to(DEVICE) for k,v in batch.items()}\n",
        "        losses.append(model(**batch).loss.item())\n",
        "    return float(sum(losses)/len(losses)) if losses else float(\"inf\")\n"
      ],
